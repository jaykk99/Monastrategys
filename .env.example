# No environment variables are required to build or run this app.
# Everything below is optional and degrades gracefully when unset.

# Firebase backend for auth + Firestore (fills firebase-applet-config.json).
# Without real values, auth/firestore calls fail gracefully and the UI stays usable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional admin backdoor login. BOTH must be set for admin login to work.
# When unset, no admin login path exists in the app.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASS=

# Optional: Gemini API key for AI-assisted features.
GEMINI_API_KEY=
